{
  "name": "@fragmentoid/turbo-crawl",
  "version": "0.5.0",
  "description": "Turn any web page into structured JSON. Claude Code or Codex writes a reusable extraction template once per page layout; every other page with that layout is scraped without calling a model. Also a Node library.",
  "keywords": [
    "scraper",
    "scraping",
    "web-scraping",
    "crawler",
    "extraction",
    "structured-data",
    "playwright",
    "claude",
    "claude-code",
    "codex",
    "llm",
    "cli"
  ],
  "author": "Daniele Calleri",
  "license": "MIT",
  "homepage": "https://github.com/dannycalleri/turbo-crawl#readme",
  "bugs": {
    "url": "https://github.com/dannycalleri/turbo-crawl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannycalleri/turbo-crawl.git"
  },
  "type": "module",
  "bin": {
    "turbo-crawl": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:inspect": "bun run --inspect-wait=localhost:6499/turbo-crawl src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test --path-ignore-patterns='test/*.e2e.test.ts' --path-ignore-patterns='test/*.browser.test.ts' && for f in test/*.browser.test.ts; do bun test \"$f\" || exit 1; done && bun test test/*.e2e.test.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/yargs": "^17.0.35",
    "playwright": "^1.65.0",
    "typescript": "^5.9.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "playwright": ">=1.60 <2"
  }
}
