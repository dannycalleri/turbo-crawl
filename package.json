{
  "name": "@fragmentoid/turbo-crawl",
  "version": "0.1.0",
  "description": "Turn any web page into structured JSON. Claude Code or Codex writes a reusable extraction template once per URL pattern; every other page is scraped without calling a model.",
  "keywords": [
    "scraper",
    "scraping",
    "web-scraping",
    "crawler",
    "extraction",
    "structured-data",
    "playwright",
    "claude",
    "claude-code",
    "codex",
    "llm",
    "cli",
    "tui"
  ],
  "author": "Daniele Calleri",
  "license": "MIT",
  "homepage": "https://github.com/dannycalleri/turbo-crawl#readme",
  "bugs": {
    "url": "https://github.com/dannycalleri/turbo-crawl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannycalleri/turbo-crawl.git"
  },
  "type": "module",
  "bin": {
    "turbo-crawl": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:inspect": "bun run --inspect-wait=localhost:6499/turbo-crawl src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@opentui/core": "^0.1.18",
    "playwright": "^1.59.1"
  },
  "devDependencies": {
    "@opentui/react": "^0.1.23",
    "@types/bun": "^1.2.21",
    "@types/react": "^19.1.12",
    "@types/yargs": "^17.0.35",
    "react": "^19.1.1",
    "typescript": "^5.9.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  }
}
